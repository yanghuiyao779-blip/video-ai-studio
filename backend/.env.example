APP_ENV=development
APP_SECRET_KEY=replace-with-at-least-32-random-characters
APP_ENCRYPTION_KEY=replace-with-a-second-random-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password
DATABASE_URL=sqlite:///./video_ai.db
DATA_DIR=./data
QUEUE_MODE=local
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
ASR_MODEL=small
ASR_DEVICE=cpu
ASR_COMPUTE_TYPE=int8
DOWNLOAD_MAX_HEIGHT=1080
MAX_VIDEO_DURATION_SECONDS=14400
MAX_DOWNLOAD_BYTES=8589934592
KEEP_SOURCE_MEDIA=false
YTDLP_COOKIES_FILE=
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Optional assistant features; defaults are safe/off.
ASSISTANT_MAX_CONTEXT_CHARS=40000
ASSISTANT_HISTORY_CHARS=24000
ASSISTANT_MAX_RESOURCES=20
ASSISTANT_WEB_API_KEY=
ASSISTANT_CAPTURE_FRAMES=false
ASSISTANT_VISION_MODEL=
ASSISTANT_VISION_BASE_URL=
ASSISTANT_VISION_API_KEY=
ASSISTANT_MAX_FRAMES=6
ASSISTANT_AGENT_MAX_STEPS=4
