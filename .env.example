APP_SECRET_KEY=replace-with-a-long-random-secret
APP_ENCRYPTION_KEY=replace-with-a-second-long-random-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password

POSTGRES_DB=video_ai
POSTGRES_USER=video_ai
POSTGRES_PASSWORD=replace-with-a-database-password

ASR_MODEL=small
ASR_DEVICE=cpu
ASR_COMPUTE_TYPE=int8
DOWNLOAD_MAX_HEIGHT=1080
MAX_VIDEO_DURATION_SECONDS=14400
MAX_DOWNLOAD_BYTES=8589934592
KEEP_SOURCE_MEDIA=false

# Optional server-side Netscape cookie file for content that requires login.
# Mount the file separately; never commit it to source control.
YTDLP_COOKIES_FILE=
PLAYWRIGHT_PROFILE_DIR=/data/playwright/douyin

# Assistant v3 (optional; no keys are shipped)
ASSISTANT_MAX_CONTEXT_CHARS=40000
ASSISTANT_HISTORY_CHARS=24000
ASSISTANT_RUN_LEASE_SECONDS=900
ASSISTANT_MAX_WAIT_SECONDS=21600
ASSISTANT_MAX_RESOURCES=20
# Tavily search. Only enabled by a per-message user consent flag.
ASSISTANT_WEB_API_KEY=
# Sampled-frame vision through a chat-completions compatible model.
ASSISTANT_CAPTURE_FRAMES=false
ASSISTANT_VISION_MODEL=
ASSISTANT_VISION_BASE_URL=
ASSISTANT_VISION_API_KEY=
ASSISTANT_MAX_FRAMES=6
ASSISTANT_AGENT_MAX_STEPS=4
